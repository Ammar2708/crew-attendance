{
  "expo": {
    "name": "Prime Build Work Limited",
    "slug": "crew-attendance",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/prime-build-icon.png",
    "scheme": "crewattendance",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/prime-build-icon.png",
      "bundleIdentifier": "com.crewattendance.app"
    },
    "android": {
      "package": "com.crewattendance.app",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#8F8C87",
        "foregroundImage": "./assets/images/prime-build-icon.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.CAMERA"
      ]
    },
    "web": {
      "output": "static",
      "name": "Prime Build Work Limited",
      "favicon": "./assets/images/prime-build-icon.png"
    },
    "plugins": [
      "expo-router",
      "expo-dev-client",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow Prime Build Work Limited to use location services for clock-in, clock-out, and task address lookup."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Prime Build Work Limited to take task completion photos.",
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": false
        }
      ],
      [
        "expo-media-library",
        {
          "granularPermissions": ["photo"],
          "photosPermission": "Allow Prime Build Work Limited to save task completion photos to your photo library.",
          "savePhotosPermission": "Allow Prime Build Work Limited to save task completion photos to your photo library."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#F5A623",
          "defaultChannel": "default"
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#EDEAE2",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "926421bc-d093-4e2f-8c03-22b9f9562989"
      }
    },
    "owner": "ammar4556"
  }
}
